# CinemiX 環境変数（名前だけ。値はコミットしない）
# B 段階（オンライン共有）を使うときだけ設定する。未設定でも A（ローカル編集・書き出し）は動く。
VITE_SUPABASE_URL=
# publishable / anon key のみ。service_role キーは絶対に Web へ入れない。
VITE_SUPABASE_PUBLISHABLE_KEY=

# 開発専用: 「テスト広告」のシミュレート（1 で有効。実広告 SDK は接続しない）
VITE_DEV_ADS=

# ルート1: 同一 Wi-Fi の HTTPS 開発サーバー（mkcert で作った証明書のパス。秘密鍵は iPhone に送らない）
DEV_HTTPS_CERT=
DEV_HTTPS_KEY=
